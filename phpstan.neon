parameters:
    level: 5
    paths:
        - pilgrimz-tour-map.php

    # Exclude vendor directory
    excludePaths:
        - vendor/
        - node_modules/

    # Bootstrap WordPress stubs
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    # Ignore WordPress functions that PHPStan doesn't understand
    ignoreErrors:
        # WordPress core functions are always available
        - '#Function (esc_html__|esc_attr|esc_html|get_locale|get_option|current_user_can|add_settings_error|settings_errors|get_admin_page_title|settings_fields|do_settings_sections|submit_button|load_plugin_textdomain|plugin_basename|plugin_dir_path|plugin_dir_url|wp_enqueue_script|has_shortcode|shortcode_atts|add_shortcode|add_options_page|add_action|register_setting|add_settings_section|add_settings_field) not found#'
        # WordPress constants
        - '#Constant (WPINC) not found#'
